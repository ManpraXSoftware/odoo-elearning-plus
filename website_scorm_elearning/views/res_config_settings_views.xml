<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Configure access keys    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.amazon.s3.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_slides.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_slides_selection_settings']" position="after">
                <h2>Amazon S3 Cloud Storage</h2>
                <div class="row mt16 o_settings_container" id="amazon_s3_settings">
                    <div class="col-12 col-lg-7 o_setting_box" id="amazon">
                        <div class="o_setting_left_pane">
                            <field name="is_amazon_connector"
                                string="Amazon S3 Cloud Storage"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_amazon_connector"/>
                            <div class="text-muted">
                                Synchronize Scorm with Amazon S3 Cloud Storage
                            </div>
                        </div>
                        <br/>
                        <div class="o_setting_right_pane" invisible="(is_amazon_connector == False)">
                            <div class="row mt6">
                                <div class="col-5">
                                    <label for="amazon_access_key">Access key:</label>
                                </div>
                                <div class="col-5">
                                    <field name="amazon_access_key" class="oe_inline" />
                                </div>
                            </div>

                            <div class="row mt6">
                                <div class="col-5">
                                    <label for="amazon_secret_key">Secret access key:</label>
                                </div>
                                <div class="col-5">
                                    <field name="amazon_secret_key" password="True" class="oe_inline"/>
                                </div>
                            </div>

                            <div class="row mt6">
                                <div class="col-5">
                                    <label for="amazon_bucket_name">Bucket Name:</label>
                                </div>
                                <div class="col-5">
                                    <field name="amazon_bucket_name" class="oe_inline"/>
                                </div>
                            </div>

                            <div class="row mt8">
                                <div class="col">
                                    <button name="action_test_amazon_s3_connection"
                                            type="object"
                                            string="Test Connection"
                                            class="btn btn-primary"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
